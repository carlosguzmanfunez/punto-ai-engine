# Entornos virtuales
.venv/
venv/
env/

# Caché de Python
__pycache__/
*.pyc

# Caché de herramientas
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Variables de entorno
.env
.env.*
!.env.example

# Configuración local generada por el dashboard de proveedores: es de esta máquina y de este
# usuario (transporte, modelo, roles y proveedores nuevos), no del repositorio. No contiene
# credenciales: las claves viven en el almacén de secretos, fuera del árbol.
config/providers.local.yaml

# Memoria operativa de PELL (conocimiento acumulado por este motor en esta máquina). Es estado de
# ejecución, no producto: se versiona el código que la lee y escribe, no su contenido.
.punto-memory/

# Artefactos de construcción
dist/
build/
*.egg-info/

# Paquetes de auditoría y entrega: se generan en la raíz, pero nunca se versionan.
# Se crean para revisión externa, no son parte del producto.
*_CLAUDE_AUDIT.zip
*_DELIVERY.zip
