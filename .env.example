# PUNTO AI ENGINE - variables de entorno (ENGINE-0)
#
# ENGINE-0 es 100% local y determinista: NO existen claves de proveedores LLM,
# ni credenciales de Neon/GitHub/Vercel/Redis/Temporal. Estas variables solo
# controlan la carga local de configuración y la API.
#
# Copiar a `.env` solo si se necesita sobreescribir la configuración por defecto.

# Nombre del entorno lógico (ver config/environments.yaml).
PUNTO_ENVIRONMENT=local

# Directorio raíz de configuración (por defecto: <repo>/config).
# PUNTO_CONFIG_DIR=/ruta/absoluta/a/config

# Sobreescrituras opcionales de archivos de configuración individuales.
# PUNTO_CONSTITUTION_FILE=config/constitution.yaml
# PUNTO_PERMISSIONS_FILE=config/permissions.yaml
# PUNTO_RISK_RULES_FILE=config/risk-rules.yaml
# PUNTO_BUDGETS_FILE=config/budgets.yaml
# PUNTO_MODELS_FILE=config/models.yaml
# PUNTO_ENVIRONMENTS_FILE=config/environments.yaml

# Host y puerto de la API local.
PUNTO_API_HOST=127.0.0.1
PUNTO_API_PORT=8000

# Nivel de log de la aplicación.
PUNTO_LOG_LEVEL=INFO

# Prohibido por constitución en ENGINE-0: sin secretos de terceros.
# OPENAI_API_KEY=
# DATABASE_URL=

# ----------------------------------------------------------------------------
# ENGINE-2 - DeepSeek Developer Integration
# ----------------------------------------------------------------------------
# Credencial del modelo. NUNCA se escribe un valor real en el repositorio.
# Vive únicamente en el proceso que llama al modelo: no entra al sandbox, ni al
# workspace, ni al código generado, ni a los logs de auditoría.
# DEEPSEEK_API_KEY=

# URL base oficial de la API.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Modelo del Developer. Soportados: deepseek-v4-pro, deepseek-v4-flash.
# Los alias heredados (deepseek-chat, deepseek-reasoner) no se aceptan.
DEEPSEEK_MODEL=deepseek-v4-pro

# ----------------------------------------------------------------------------
# ENGINE-3 - Architect + Project Planning Layer
# ----------------------------------------------------------------------------
# El routing de modelos es configuración, no código: cada rol puede apuntar a un
# modelo distinto. Si la variable no existe, el rol usa `deepseek-v4-pro`.
# Soportados: deepseek-v4-pro, deepseek-v4-flash.
# PUNTO_ARCHITECT_MODEL=deepseek-v4-pro
# PUNTO_PLANNER_MODEL=deepseek-v4-pro

# Presupuesto de salida de una planificación.
# Con `thinking` activo, el razonamiento consume el MISMO presupuesto que el
# documento JSON. Medido con deepseek-v4-pro y reasoning_effort=high:
#   - un diseño de arquitectura completo necesitó ~11 400 tokens de salida;
#   - un roadmap SIN cota de tamaño llegó a 86 656 caracteres antes de truncarse.
# Con un tope corto (8 192) la respuesta llegaba cortada a mitad de una cadena y
# con finish_reason='length'. El motor usa 65 536 por defecto y además acota el
# plan en el prompt (máximo 4 milestones, 8 epics y 20 tareas).
# PUNTO_PLANNING_MAX_TOKENS=65536

# ----------------------------------------------------------------------------
# ENGINE-4 - Independent QA Agent
# ----------------------------------------------------------------------------
# Modelo del QA independiente. Si la variable no existe, usa `deepseek-v4-pro`.
# Soportados: deepseek-v4-pro, deepseek-v4-flash.
# PUNTO_QA_MODEL=deepseek-v4-pro

# ----------------------------------------------------------------------------
# ENGINE-5 - Independent Security + Reviewer Agents
# ----------------------------------------------------------------------------
# Cada rol independiente tiene su propio modelo: el veredicto de seguridad y el
# de revisión no comparten contexto ni configuración con QA ni con el Developer.
# Si la variable no existe, el rol usa `deepseek-v4-pro`.
# Soportados: deepseek-v4-pro, deepseek-v4-flash.
# PUNTO_SECURITY_MODEL=deepseek-v4-pro
# PUNTO_REVIEWER_MODEL=deepseek-v4-pro

# Nota: Security combina el análisis del modelo con comprobaciones deterministas
# (escaneo de secretos, rutas peligrosas, AST de Python y manifiestos) que se
# ejecutan en proceso y nunca ejecutan código del proyecto.
#
# Los escáneres externos (bandit, semgrep, trivy, npm-audit, osv-scanner) están
# REGISTRADOS pero no instalados. Si una tarea los exige, Security devuelve
# BLOCKED por capacidad: no se degrada en silencio ni se sustituye por una
# revisión del modelo.

# ----------------------------------------------------------------------------
# ENGINE-5.2 - Multi-provider: Anthropic/Claude + auditoría cruzada
# ----------------------------------------------------------------------------
# Credencial de Anthropic. NUNCA se escribe un valor real en el repositorio.
# Si NO existe, el motor sigue funcionando: los roles DeepSeek no la necesitan y
# la auditoría cruzada queda BLOCKED / PROVIDER_UNAVAILABLE, nunca sustituida por
# DeepSeek. Los live gates de Claude quedan PENDING_API_KEY.
# ANTHROPIC_API_KEY=

# URL base oficial de la API de Anthropic.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Modelo del auditor cruzado (rol CROSS_AUDITOR) y modelo de los roles visuales
# (VISUAL_ARCHITECT, FRONTEND_SPECIALIST, VISUAL_QA: comparten variable porque en
# esta fase son el mismo tipo de trabajo).
# Los identificadores por defecto son los PUBLICADOS por el proveedor: el ID está
# documentado. Lo que no se pudo verificar, por falta de credencial, es el ACCESO de
# esta cuenta a ellos (LIVE_ACCOUNT_ACCESS_UNVERIFIED). No hay lista blanca: un ID
# distinto se acepta, y uno equivocado se verá como un 404 explícito del proveedor.
# PUNTO_CLAUDE_AUDIT_MODEL=claude-opus-5
# PUNTO_CLAUDE_VISUAL_MODEL=claude-sonnet-5

# Presupuesto de salida de una llamada a Claude.
# PUNTO_CLAUDE_MAX_TOKENS=8192

# Structured Outputs: los roles que piden un contrato estructurado envían un JSON
# Schema real en output_config.format. DeepSeek conserva su mecanismo nativo y
# recibe el esquema como contrato textual. No hay nada que configurar para eso.

# El proveedor de cada rol es configuración explícita, no detección automática.
# Forzar el proveedor de un rol (por defecto: deepseek para los seis roles
# originales y anthropic para CROSS_AUDITOR y los visuales):
# PUNTO_CROSS_AUDITOR_PROVIDER=anthropic
# PUNTO_QA_PROVIDER=deepseek

# NO hay fallback silencioso entre proveedores: si un rol pide un proveedor que
# no está disponible, la operación falla o queda BLOCKED de forma explícita.

# ----------------------------------------------------------------------------
# ENGINE-5.3 - Web + Visual Execution Foundation
# ----------------------------------------------------------------------------
# No hay variables nuevas: esta fase no se configura por entorno.
#
# La imagen del sandbox web (Node + Playwright + Chromium) se construye una vez:
#   podman build -t localhost/punto-sandbox-web:0.1 sandbox/web/
# Si no existe, la operación falla con WEB_SANDBOX_REQUIRED y el comando exacto:
# no hay degradación a un modo sin capturas.
#
# Política de red: la sesión de navegador corre con `--network none` (solo
# loopback, verificado). La resolución de dependencias NO es ejecución del
# producto: en esta fase no hay red general dentro de la sesión, así que un
# proyecto cuyas dependencias no estén ya disponibles no se puede construir. Se
# declara como bloqueo; no se bajan paquetes a escondidas.
#
# El modelo de los roles visuales usa PUNTO_CLAUDE_VISUAL_MODEL (arriba). Sin
# ANTHROPIC_API_KEY, Visual QA contra Claude queda PENDING_API_KEY.

# ----------------------------------------------------------------------------
# ENGINE-5.3.1 - Trusted Web Evidence + Visual Completeness Hardening
# ----------------------------------------------------------------------------
# Tampoco hay variables nuevas.
#
# La medición web corre ahora en DOS contenedores sobre una red interna del
# sandbox (--internal, sin ruta a Internet):
#   - contenedor no confiable: el proyecto y su preview (workspace rw);
#   - contenedor confiable:  el navegador y la evidencia.
# El codigo de medicion y el control se montan read-only en /opt/punto/probe y
# el directorio de evidencia vive FUERA del workspace, montado solo en el
# contenedor confiable. El proyecto no puede escribir el probe, ni el control,
# ni la evidencia.
#
# La imagen solo trae npm/npx (y node/python3). Un proyecto que declare pnpm,
# yarn o bun NO cae en npm en silencio: la sesion falla nombrando el programa
# que falta (PUNTO_PROGRAM_MISSING).

# ----------------------------------------------------------------------------
# ENGINE-6.0 - Autonomous Workflow Kernel
# ----------------------------------------------------------------------------
# No hay variables nuevas: el kernel no se configura por entorno.
#
# El kernel es provider-neutral y funciona SIN credenciales: cada rol declara
# su capacidad y, si el proveedor que lo cubre no esta disponible, la operacion
# queda PROVIDER_UNAVAILABLE / PENDING_CREDENTIALS. Nunca se sustituye por otro
# proveedor sin una politica determinista explicita (que esta fase no habilita).
#
# Estado de capacidades declarado hoy:
#   - deepseek: roles de ingenieria, requiere DEEPSEEK_API_KEY;
#   - anthropic: CrossAudit y VisualQA (vision), requiere ANTHROPIC_API_KEY;
#   - openai: rol ARCHITECT de la orquestacion multi-proveedor, requiere OPENAI_API_KEY;
#   - fake: siempre disponible, solo para pruebas offline.
#
# Los human gates no se autoaprueban y el ciclo de reparacion autonomo es
# ENGINE-6.1: ENGINE-6.0 llega a REPAIRING y se detiene con
# WORKFLOW_REPAIR_DEFERRED.

# ----------------------------------------------------------------------------
# MULTI-PROVIDER v0 - Orquestacion de proveedores por rol
# ----------------------------------------------------------------------------
# Los proveedores se registran y se asignan por ROL (ARCHITECT, BUILDER,
# VISUAL_QA) segun config/providers.yaml; cambiar la asignacion o el modelo no
# requiere tocar el motor. Aqui solo hay PLACEHOLDERS: ninguna clave real.
# OPENAI_API_KEY=<required>
# DEEPSEEK_API_KEY=<required>
# ANTHROPIC_API_KEY=<required>
#
# Sobreescrituras opcionales, equivalentes a editar config/providers.yaml:
# PUNTO_ARCHITECT_PROVIDER=openai
# PUNTO_BUILDER_PROVIDER=deepseek
# PUNTO_VISUAL_QA_PROVIDER=anthropic
# PUNTO_OPENAI_MODEL=gpt-5-codex
# PUNTO_DEEPSEEK_MODEL=deepseek-v4-pro
# PUNTO_ANTHROPIC_MODEL=claude-sonnet-5
#
# Un proveedor caido no rompe el motor: la peticion vuelve FAILED o UNAVAILABLE
# con su causa normalizada (TIMEOUT, RATE_LIMIT, AUTHENTICATION, NETWORK, ...).
# No hay fallback automatico entre proveedores.
#
# La salida de un proveedor es INTELEGENCIA EXTERNA NO CONFIABLE: no concede
# capacidades, no amplia el ResourceSet y no salta el Human Gate.

# ----------------------------------------------------------------------------
# SUBSCRIPTION TRANSPORTS v0 - Codex / Claude Code debajo del provider
# ----------------------------------------------------------------------------
# Cada proveedor puede usar su CLIENTE OFICIAL de suscripcion (Codex con cuenta
# ChatGPT, Claude Code con cuenta Claude) o su API con clave. Se elige en
# config/providers.yaml; el motor no cambia y no sabe cual esta seleccionado.
#
# La SESION la administra el cliente oficial. PUNTO no pide contrasenas, no lee
# cookies, no copia tokens y no inicia sesion por su cuenta:
#   codex login            (cuenta ChatGPT)
#   claude auth login      (cuenta Claude)
# El estado se consulta con los comandos oficiales:
#   codex login status
#   claude auth status --json
#
# Sobreescrituras opcionales del transporte y del modo de autenticacion:
# PUNTO_OPENAI_TRANSPORT=codex          # o api
# PUNTO_OPENAI_AUTH_MODE=chatgpt        # o api_key
# PUNTO_ANTHROPIC_TRANSPORT=claude_code # o api
# PUNTO_ANTHROPIC_AUTH_MODE=claude_account
# PUNTO_DEEPSEEK_TRANSPORT=existing
# PUNTO_DEEPSEEK_AUTH_MODE=api_key
#
# SIN FALLBACK AUTOMATICO: si la suscripcion agota su limite, la peticion vuelve
# con su fallo normalizado (LIMIT_REACHED / RATE_LIMIT) y la API de pago NO se
# invoca. Cambiar de transporte es una decision de configuracion explicita.
#
# Codex y Claude Code en modo no interactivo son de TEXTO: no aceptan nuestras
# imagenes. Para evidencia visual con adjuntos se usa el transporte api
# (multimodal); la limitacion esta declarada y probada.
