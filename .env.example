# PUNTO AI ENGINE - variables de entorno (ENGINE-0)
#
# ENGINE-0 es 100% local y determinista: NO existen claves de proveedores LLM,
# ni credenciales de Neon/GitHub/Vercel/Redis/Temporal. Estas variables solo
# controlan la carga local de configuración y la API.
#
# Copiar a `.env` solo si se necesita sobreescribir la configuración por defecto.

# Nombre del entorno lógico (ver config/environments.yaml).
PUNTO_ENVIRONMENT=local

# Directorio raíz de configuración (por defecto: <repo>/config).
# PUNTO_CONFIG_DIR=/ruta/absoluta/a/config

# Sobreescrituras opcionales de archivos de configuración individuales.
# PUNTO_CONSTITUTION_FILE=config/constitution.yaml
# PUNTO_PERMISSIONS_FILE=config/permissions.yaml
# PUNTO_RISK_RULES_FILE=config/risk-rules.yaml
# PUNTO_BUDGETS_FILE=config/budgets.yaml
# PUNTO_MODELS_FILE=config/models.yaml
# PUNTO_ENVIRONMENTS_FILE=config/environments.yaml

# Host y puerto de la API local.
PUNTO_API_HOST=127.0.0.1
PUNTO_API_PORT=8000

# Nivel de log de la aplicación.
PUNTO_LOG_LEVEL=INFO

# Prohibido por constitución en ENGINE-0: sin secretos de terceros.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DATABASE_URL=
